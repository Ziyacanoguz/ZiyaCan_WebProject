<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — ZiyaCan</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="shell">

  <!-- NAVBAR -->
  <nav class="navbar">
    <a class="logo" asp-controller="Home" asp-action="Index">
      <span class="logo-mark">Z</span>
      <span class="logo-text">Ziya</span>
    </a>

    <div class="navbar-search">
      <span class="search-icon">⌕</span>
      <input type="text" placeholder="Search…" />
    </div>
  </nav>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="nav-section">
      <p class="nav-label">Menu</p>
      <a class="nav-item @(ViewData["Page"]?.ToString() == "Home"      ? "active" : "")" asp-controller="Home"      asp-action="Index">Home</a>
      <a class="nav-item @(ViewData["Page"]?.ToString() == "Browse"    ? "active" : "")" asp-controller="Menu"      asp-action="Index">Browse</a>
      <a class="nav-item @(ViewData["Page"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
      @if (User.IsInRole("User"))
      {
        <div class="nav-section">
          <p class="nav-label">My Account</p>
          <a class="nav-item" asp-controller="Order"   asp-action="Index">My Orders</a>
          <a class="nav-item" asp-controller="Cart"    asp-action="Index">Cart</a>
        </div>
      }
      @if (User.IsInRole("Caterer"))
      {
        <div class="nav-section">
          <p class="nav-label">Restaurant</p>
          <a class="nav-item" asp-controller="Caterer" asp-action="Menu">My Menu</a>
          <a class="nav-item" asp-controller="Caterer" asp-action="Orders">Orders</a>
        </div>
      }
      @if (User.IsInRole("Admin"))
      {
        <div class="nav-section">
          <p class="nav-label">Admin</p>
          <a class="nav-item" asp-controller="Admin" asp-action="Users">Users</a>
          <a class="nav-item" asp-controller="Admin" asp-action="Caterers">Caterers</a>
          <a class="nav-item" asp-controller="Admin" asp-action="Logs">Logs</a>
        </div>
      }
    }

    <div class="sidebar-bottom">
      @if (User.Identity?.IsAuthenticated == true)
      {
        <form asp-controller="Account" asp-action="Logout" method="post">
          @Html.AntiForgeryToken()
          <button type="submit" class="nav-item" style="width:100%;background:none;border:none;cursor:pointer;color:var(--danger)">
            Sign Out
          </button>
        </form>
      }
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    @RenderBody()
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <span>© 2025 <strong>ZiyaCan</strong></span>
    <span style="color:var(--muted)">Built with ASP.NET Core MVC</span>
  </footer>

</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
